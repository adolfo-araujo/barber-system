# Banco de dados PostgreSQL (o docker-compose.yml sobe exatamente este banco)
DATABASE_URL="postgresql://postgres:password@localhost:5432/barber?schema=public"
DATABASE_URL_UNPOOLED="postgresql://postgres:password@localhost:5432/barber?schema=public"

# NextAuth
# Gere um segredo com: openssl rand -base64 32
NEXTAUTH_SECRET="troque-este-segredo"
NEXTAUTH_URL="http://localhost:3000"

# Login com Google (opcional). Se ficar vazio, apenas o login por e-mail/senha é exibido.
# Crie as credenciais em https://console.cloud.google.com/apis/credentials
# URI de redirecionamento autorizado: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Fuso horário usado para os horários de atendimento das barbearias
NEXT_PUBLIC_TIMEZONE="America/Sao_Paulo"
